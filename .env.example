# Core
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_API_URL=http://localhost:8000
# Comma-separated — accounts with these emails are auto-promoted to platform
# super admin on signup/login.
SUPERADMIN_EMAILS=
# Fernet key encrypting payment_gateways.*_client_secret at rest. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_SECRET_KEY=
PAYMENT_MODE=test

# ───────────────────────────────────────────────────────────────
# App data + vectors — ONE PostgreSQL database (pgvector extension).
# Local dev: the docker-compose `db` service (pgvector/pgvector image,
# host port 55432) — values below match it out of the box.
# Production: point these at a Supabase project's connection details
# instead (Project Settings -> Database -> Connection string). Same
# driver (asyncpg), same schema — no code change needed to switch.
# ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=55432
DB_USER=sanchijawab
DB_PASS=sanchijawab
DB_NAME=sanchijawab

# (No sc_tenants integration — SanchiJawab is a standalone project, not
# connected to SanchiSaas or the company's shared tenant registry. Its own
# tenant_id is generated locally at signup; see knowledge.md.)

# Embeddings — knowledge passages and visitors' questions are embedded with Google's gemini-embedding-001
# (768 dimensions) using CLOUD_API_KEY below. The small local model (EMBED_DIM) is only used for the product
# catalogue. After upgrading an existing install the worker fills in the new vectors by itself; to do it on
# demand run `python -m app.reembed`.
EMBED_PROVIDER=fastembed
EMBED_DIM=384
EMBED_DIM_V2=768
COHERE_API_KEY=

# ───────────────────────────────────────────────────────────────
# AI Provider — single API key slot; the active provider knows how to use it.
# Phase 0 PoC (app/poc/ask.py) already uses this. Phase 1 target: google
# (Gemini) for both the fast and main answer tiers.
# ───────────────────────────────────────────────────────────────
DEFAULT_PROVIDER=google
CLOUD_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Crawling — new website sources read every page by default (up to MAX_PAGES_PER_SITE).
# CRAWL_CONCURRENCY pages are fetched at the same time (a site whose robots.txt asks for a delay gets 1).
MAX_PAGES_PER_SITE=5000
CRAWL_CONCURRENCY=8
CRAWL_DELAY_SECONDS=0.2
RENDER_JS=false

# File uploads
MAX_FILE_MB=50
MAX_PDF_PAGES=200

# Inbox / rate limiting
AGENT_ONLINE_SECONDS=120
VISITOR_RATE_PER_MINUTE=20

# Observability (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# development | staging | production — tags every trace so they can be
# filtered by deployment stage once this runs somewhere other than a laptop.
LANGFUSE_ENVIRONMENT=development

# File storage — Amazon S3 (replaces local disk / generic S3_* vars)
AMAZON_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
AMAZON_REGION=
AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_S3_BUCKET=

# Email (signup verification, team invitations) — any SMTP provider works
# (Amazon SES's SMTP endpoint, SendGrid, Mailgun, a Gmail app password...).
# Leave SMTP_HOST blank to skip sending (dev mode; tokens still work via
# the API response fallback). This project uses SendGrid: SMTP_USER is
# literally "apikey", SMTP_PASSWORD is your real SendGrid API key.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=SanchiJawab <no-reply@sanchijawab.com>
SUPPORT_EMAIL=support@sanchijawab.com
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Added for deployment (see DEPLOYMENT.md)
# ─────────────────────────────────────────────────────────────────────────────
# Public URLs, baked into the dashboard image at build time (docker-compose.yml).
# PUBLIC_API_URL        where visitors' browsers reach the API, e.g. https://api.example.com
# PUBLIC_WIDGET_URL     the full address of widget.js, e.g. https://cdn.example.com/widget.js
# PUBLIC_SITE_URL       where the dashboard/website is served, e.g. https://app.example.com
PUBLIC_WIDGET_URL=
PUBLIC_SITE_URL=

# Security switches. Leave these at their defaults in production.
# RATE_LIMIT_ENABLED=true     per-IP limits on login/signup/public chat routes
# ALLOW_PRIVATE_URLS=false    NEVER true in production; lets the crawler/webhooks reach internal addresses

# Answer models. gemini-2.5-flash is the default; bots can pick economy/quality.
# GEMINI_MODEL_ECONOMY=gemini-2.5-flash-lite
# GEMINI_MODEL_QUALITY=gemini-2.5-pro

# Optional answer re-ranking (improves accuracy slightly). Needs COHERE_API_KEY above.
# COHERE_RERANK_MODEL=rerank-v3.5
# RERANK_CANDIDATES=30
